{
  "type": "module",
  "name": "vite-starter",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "imports": "node ./app/npm-scripts/add-imports.js",
    "validate:html": "html-validate \"./build/**/*.html\"",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:scss:fix": "stylelint \"src/**/*.scss\" --fix",
    "lint:ts": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
    "lint:ts:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "lint": "npm run lint:scss && npm run lint:ts",
    "lint:fix": "npm run lint:scss:fix && npm run lint:ts:fix",
    "format": "prettier --write \"src/**/*.{scss,ts,js,json}\" && npm run format:pug",
    "format:check": "prettier --check \"src/**/*.{scss,ts,js,json}\" && npm run format:pug:check",
    "format:pug": "node ./app/npm-scripts/format-pug.js",
    "format:pug:check": "node ./app/npm-scripts/format-pug.js --check"
  },
  "author": "Viktor Konovalov",
  "license": "ISC",
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@mish.dev/vite-convert-pug-in-html": "^2.0.0",
    "@prettier/plugin-pug": "^3.4.2",
    "chalk": "^5.6.2",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^10.1.8",
    "html-validate": "^10.9.0",
    "prettier": "^3.0.0",
    "pug": "^3.0.4",
    "sass": "^1.98.0",
    "stylelint": "^16.18.0",
    "stylelint-config-prettier": "^9.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.0.0",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.3.1",
    "vite-plugin-purgecss": "^0.2.13"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "swiper": "^12.1.3",
    "tippy.js": "^6.3.7"
  }
}
